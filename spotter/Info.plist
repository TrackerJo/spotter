<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSSupportsLiveActivities</key><true/>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLName</key><string>workout</string><key>CFBundleURLSchemes</key><array><string>spotter</string></array></dict></array>
	<key>CFBundleDisplayName</key>
	<string>Spotter</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_spotter-gym._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect directly to your workout partner’s phone to sync sets without gym internet.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
